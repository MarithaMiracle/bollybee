NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Local dev: http://localhost:3000
# Production (Vercel): https://bollybee.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxx
# Optional — Paystack signs webhooks with PAYSTACK_SECRET_KEY; only set this to override
PAYSTACK_WEBHOOK_SECRET=

# Resend (test mode — use onboarding@resend.dev until domain is verified)
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=Bollybee <onboarding@resend.dev>
# Redirect all outbound mail here while using resend.dev sender
# MUST match the email on your Resend account (test mode only sends there)
RESEND_TEST_TO=bollybeefraglab@gmail.com
ADMIN_EMAIL=bollybeefraglab@gmail.com

# Protect /api/cron/emails (Vercel Cron sends Authorization: Bearer CRON_SECRET)
CRON_SECRET=generate-a-long-random-string

# Optional — for npm run db:seed (Supabase → Settings → Database → URI)
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres